# Endereço do backend Spring visto pelo servidor do Next (o navegador nunca acessa esse endereço).
# Em produção, deixe o backend acessível só pela rede interna.
BACKEND_URL=http://localhost:8080

# Cookie de sessão do admin é "Secure" em produção. Só use false para testar `npm start` sem HTTPS.
# COOKIE_SECURE=false
